{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2020",
    "jsx": "react",
    "types": [
      "node",
      "chrome",
      "firefox-webext-browser",
      "mocha"
    ],
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.tsx"
  ],
  "ts-node": {
    "transpileOnly": true
  }
}
