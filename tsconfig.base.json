{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@dismoi/domain": ["packages/domain"],
      "@dismoi/domain/*": ["packages/domain/*"],
      "@dismoi/ui/*": ["packages/ui/*"],
      "@dismoi/i18n": ["packages/i18n"],
      "@dismoi/i18n/*": ["packages/i18n/*"],
      "@dismoi/extension/*": ["packages/extension/*"],
      "@dismoi/web/*": ["packages/web/*"],

      // Ces alias doublent ceux de `wxt.config.ts` et de `next.config.js` :
      // sans eux, TypeScript ne résout pas les imports historiques et
      // `tsc` ne voit qu'un module manquant là où le bundler voit du code.
      "libs/store": ["packages/extension/store"],
      "libs/store/*": ["packages/extension/store/*"],
      "libs/api": ["packages/extension/api-client"],
      "libs/api/*": ["packages/extension/api-client/*"],
      "libs/tracking": ["packages/extension/tracking"],
      "libs/tracking/*": ["packages/extension/tracking/*"],
      "libs/hooks": ["packages/extension/hooks"],
      "libs/hooks/*": ["packages/extension/hooks/*"],
      "libs/webext": ["packages/extension/webext"],
      "libs/webext/*": ["packages/extension/webext/*"],
      "libs/facets": ["packages/extension/facets"],
      "libs/facets/*": ["packages/extension/facets/*"],
      "libs/utils": ["packages/extension/utils"],
      "libs/utils/*": ["packages/extension/utils/*"],
      "app/background": ["packages/extension/background"],
      "app/background/*": ["packages/extension/background/*"],
      "app/content": ["packages/extension/content"],
      "app/content/*": ["packages/extension/content/*"],
      "app/profiles": ["packages/extension/profiles"],
      "app/profiles/*": ["packages/extension/profiles/*"],
      "assets/*": ["packages/extension/assets/*"],
      "types": ["packages/extension/types"],
      "types/*": ["packages/extension/types/*"],
      "utils/*": ["packages/extension/utils/*"],
      "test/*": ["packages/extension/test/*"]
    }
  },
  "exclude": ["node_modules", ".output", "build", "dist", ".next"]
}
