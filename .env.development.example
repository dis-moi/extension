BACKEND_ORIGIN=https://localhost:8088/api/v3/

# Refresh intervals in minutes
REFRESH_MC_INTERVAL=5
REFRESH_CONTRIBUTORS_INTERVAL=5

# UNINSTALL_ORIGIN=https://www.dismoi.io/desinstallation

# Tracking
TRACKING_BACKEND=true
#PLAUSIBLE_DOMAIN=extension.dismoi.io

#CHROME_EXTENSION_ID=

# For tooling and profiles page
#
# Identifiant de l'extension déballée. Il est indispensable : la page des
# profils s'y connecte pour connaître tes abonnements, et sans lui la saga de
# connexion échoue sur « Extension ID not configured » — les contributeurs
# s'affichent, mais aucun n'apparaît comme suivi.
#
# Chrome le dérive du chemin absolu du dossier chargé. Relève-le dans
# chrome://extensions (mode développeur), ou calcule-le :
#   node -e "const c=require('crypto');const p=process.argv[1];\
#   console.log([...c.createHash('sha256').update(p).digest('hex').slice(0,32)]\
#   .map(x=>String.fromCharCode(97+parseInt(x,16))).join(''))" \
#   "$PWD/packages/extension/.output/chrome-mv3-dev"
CHROME_EXTENSION_ID=
FIREFOX_EXTENSION_ID=
# Port du site Next.js, servi par `nx run web:dev`. Volontairement hors de la
# plage 3000-3010, où le serveur de développement de WXT prend le premier port
# libre et où d'autres projets se bousculent souvent.
PROFILES_ORIGIN=http://localhost:3105

# Contributors setup
#
# Ces identifiants doivent exister dans le backend visé par BACKEND_ORIGIN.
# À chaque rafraîchissement, UPDATE_CONTRIBUTORS intersecte les abonnements
# avec les contributeurs renvoyés par l'API : tout identifiant inconnu
# disparaît silencieusement, et l'abonnement automatique à l'installation ne
# laisse aucune trace. Les valeurs ci-dessous valent pour un backend local
# fraîchement initialisé ; en pointant BACKEND_ORIGIN sur api.dismoi.io,
# reprendre celles de .env.production.
POPULAR_CONTRIBUTORS_IDS="[1, 2, 3]"
PRESELECTED_CONTRIBUTORS_IDS="[1, 2, 3, 5]"

# Sentry
SENTRY_ORG=lmem
SENTRY_PROJECT=web-extension
SENTRY_DSN=https://a22936b545a54f37b153b3f9e2c98790@sentry.io/1404847

# API et administration (packages/api)
#
# La base est celle du backend PHP, lue sans jamais être migrée. Les valeurs
# par défaut visent le conteneur de développement de docker-compose.yml, dont
# le mot de passe est jetable.
#DISMOI_DB_HOST=127.0.0.1
#DISMOI_DB_PORT=3310
#DISMOI_DB_NAME=dismoi
#DISMOI_DB_USER=root
#DISMOI_DB_PASSWORD=dev
#DISMOI_DB_MAX_CONNECTIONS=10

# Clé de signature des sessions d'administration. Obligatoire en production.
#DISMOI_ADMIN_SECRET=

# Racine des images téléversées, servies à la place du backend PHP sous
# /uploads et /media/cache. Elle contient la disposition de Vich et de
# LiipImagine : uploads/avatars, uploads/notice_screenshots, media/cache. Le
# défaut est relatif au répertoire du serveur Next, donc packages/web/stockage.
#DISMOI_STORAGE=stockage

# Relais SMTP des notifications de contribution. Sans DISMOI_SMTP_HOST, les
# courriels sont journalisés et non envoyés. La production relaie par Brevo
# (smtp-relay.brevo.com:587), où l'utilisateur est une adresse et le mot
# de passe une clé SMTP — pas le mot de passe du compte.
#DISMOI_SMTP_HOST=smtp-relay.brevo.com
#DISMOI_SMTP_PORT=587
#DISMOI_SMTP_USER=
#DISMOI_SMTP_PASSWORD=
# STARTTLS obligatoire par défaut : à ne désactiver que face à un relais qui
# ne le propose pas, les identifiants passant alors en clair.
#DISMOI_SMTP_REQUIRE_TLS=true
# TLS implicite, déduit du port 465 quand la variable est absente.
#DISMOI_SMTP_SECURE=false

# Origine du site, qui sert à composer le lien vers l'administration dans les
# notifications de contribution.
#DISMOI_SITE_URL=https://www.dismoi.io
