BACKEND_ORIGIN=https://localhost:8088/api/v3/

# Refresh intervals in minutes
REFRESH_MC_INTERVAL=5
REFRESH_CONTRIBUTORS_INTERVAL=5

# UNINSTALL_ORIGIN=https://www.dismoi.io/desinstallation

# Tracking
TRACKING_BACKEND=true
# Each one names a site declared in Plausible; nothing is measured without it
#PLAUSIBLE_EXTENSION_DOMAIN=extension.dismoi.io
#PLAUSIBLE_SITE_DOMAIN=dismoi.io

#CHROME_EXTENSION_ID=

# For tooling and profiles page
#
# Identifier of the unpacked extension. It is indispensable: the profiles
# page connects to it to know your subscriptions, and without it the sign-in
# saga fails on "Extension ID not configured" — the contributors show, but
# none appears as followed.
#
# Chrome derives it from the absolute path of the loaded folder. Read it in
# chrome://extensions (developer mode), or compute it:
#   node -e "const c=require('crypto');const p=process.argv[1];\
#   console.log([...c.createHash('sha256').update(p).digest('hex').slice(0,32)]\
#   .map(x=>String.fromCharCode(97+parseInt(x,16))).join(''))" \
#   "$PWD/packages/extension/.output/chrome-mv3-dev"
CHROME_EXTENSION_ID=
FIREFOX_EXTENSION_ID=
# Port of the Next.js site, served by `nx run web:dev`. Deliberately outside
# the 3000-3010 range, where the WXT development server takes the first free
# port and where other projects often jostle.
PROFILES_ORIGIN=http://localhost:3105

# Contributors setup
#
# These identifiers have to exist in the backend BACKEND_ORIGIN points at.
# On every refresh, UPDATE_CONTRIBUTORS intersects the subscriptions with the
# contributors the API returns: any unknown identifier disappears silently,
# and the automatic subscription on install leaves no trace. The values below
# hold for a freshly initialised local backend; when pointing BACKEND_ORIGIN
# at api.dismoi.io, take the ones of .env.production.
POPULAR_CONTRIBUTORS_IDS="[1, 2, 3]"
PRESELECTED_CONTRIBUTORS_IDS="[1, 2, 3, 5]"

# Sentry
SENTRY_ORG=lmem
SENTRY_PROJECT=web-extension
SENTRY_DSN=https://a22936b545a54f37b153b3f9e2c98790@sentry.io/1404847

# API and administration (packages/api)
#
# The database is the one of the PHP backend, read without ever being
# migrated. The default values aim at the development container of
# docker-compose.yml, whose password is disposable.
#
# In production nothing here is set: the MYSQL_ADDON_* variables the host
# injects when a MySQL add-on is linked are read instead. These take
# precedence over them, to point a run at another database.
#DISMOI_DB_HOST=127.0.0.1
#DISMOI_DB_PORT=3310
#DISMOI_DB_NAME=dismoi
#DISMOI_DB_USER=root
#DISMOI_DB_PASSWORD=dev
#DISMOI_DB_MAX_CONNECTIONS=10

# Signing key of the administration sessions. Required in production.
#DISMOI_ADMIN_SECRET=

# Root of the uploaded images, served in place of the PHP backend under
# /uploads and /media/cache. It holds the layout of Vich and of LiipImagine:
# uploads/avatars, uploads/notice_screenshots, media/cache. The default is
# relative to the directory of the Next server, so packages/web/storage.
#DISMOI_STORAGE=storage

# SMTP relay of the contribution notifications. Without DISMOI_SMTP_HOST, the
# emails are logged and not sent. Production relays through Brevo
# (smtp-relay.brevo.com:587), where the user is an address and the password
# an SMTP key — not the password of the account.
#DISMOI_SMTP_HOST=smtp-relay.brevo.com
#DISMOI_SMTP_PORT=587
#DISMOI_SMTP_USER=
#DISMOI_SMTP_PASSWORD=
# STARTTLS required by default: to be turned off only against a relay that
# does not offer it, the credentials then travelling in the clear.
#DISMOI_SMTP_REQUIRE_TLS=true
# Implicit TLS, inferred from port 465 when the variable is absent.
#DISMOI_SMTP_SECURE=false

# Origin of the site, used to compose the link to the administration in the
# contribution notifications.
#DISMOI_SITE_URL=https://www.dismoi.io
