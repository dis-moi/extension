BACKEND_ORIGIN=https://localhost:8088/api/v3/

# Refresh intervals in minutes
REFRESH_MC_INTERVAL=5
REFRESH_CONTRIBUTORS_INTERVAL=5

# UNINSTALL_ORIGIN=https://www.dismoi.io/desinstallation

# Tracking
TRACKING_BACKEND=true
#PLAUSIBLE_DOMAIN=extension.dismoi.io

#CHROME_EXTENSION_ID=

# For tooling and profiles page
CHROME_EXTENSION_ID=
FIREFOX_EXTENSION_ID=
# Port du site Next.js, servi par `nx run web:dev`. Volontairement hors de la
# plage 3000-3010, où le serveur de développement de WXT prend le premier port
# libre et où d'autres projets se bousculent souvent.
PROFILES_ORIGIN=http://localhost:3105
PROFILES_ASSETS_PATH=/

# Contributors setup
POPULAR_CONTRIBUTORS_IDS="[1, 2, 3]"
PRESELECTED_CONTRIBUTORS_IDS="[1, 2, 3, 5]"

# Sentry
SENTRY_ORG=lmem
SENTRY_PROJECT=web-extension
SENTRY_DSN=https://a22936b545a54f37b153b3f9e2c98790@sentry.io/1404847
