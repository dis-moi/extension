{
  "compilerOptions": {
    "target": "es5",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": "../../",
    "paths": {
      "libs/*": ["libs/*"],
      "components/*": ["components/*"],
      "app/*": ["app/*"],
      "assets/*": ["assets/*"],
      "utils/*": ["utils/*"],
      "types/*": ["types/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "../../libs/**/*.ts",
    "../../libs/**/*.tsx",
    "../../components/**/*.ts",
    "../../components/**/*.tsx"
  ],
  "exclude": ["node_modules"]
}
