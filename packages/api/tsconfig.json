{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/packages/api",
    // `moduleResolution: bundler` comes from the shared base and fits: it
    // reads the `exports` field of the packages, so it resolves the
    // subpaths of Effect 4 (`effect/sql`, `effect/http`, `effect/schema`),
    // and it accepts relative imports without an extension like the rest of
    // the repository. This code is never run by Node directly - Next
    // compiles it, Vitest transforms it - so strict ESM resolution would
    // bring nothing.
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true
  },
  "include": ["./**/*.ts"],
  "exclude": ["./test/fixtures/**"]
}
