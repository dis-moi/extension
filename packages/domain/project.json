{
  "name": "domain",
  "sourceRoot": "packages/domain",
  "projectType": "library",
  "tags": ["scope:shared"],
  "targets": {
    "test": {
      "command": "TS_NODE_PROJECT=../../tsconfig.test.json mocha -r ts-node/register -r tsconfig-paths/register './**/*.spec.ts'",
      "options": {
        "cwd": "packages/domain"
      }
    },
    "typecheck": {
      "command": "tsc -p packages/domain/tsconfig.json --noEmit"
    }
  }
}
