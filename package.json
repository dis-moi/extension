{
  "name": "dismoi",
  "version": "3.98.0",
  "private": true,
  "description": "DisMoi monorepo — extension navigateur, website, packages partagés.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "cd packages/extension && wxt prepare",
    "dev": "nx run-many -t dev -p extension web --parallel=2 --output-style=stream",
    "dev:extension": "nx run extension:dev",
    "dev:firefox": "nx run extension:dev:firefox",
    "dev:web": "nx run web:dev",
    "build:extension": "nx run extension:build",
    "build:web": "nx run web:build",
    "build": "nx run web:build",
    "start": "nx run web:start",
    "build:chromium": "nx run extension:build",
    "build:firefox": "nx run extension:build:firefox",
    "build:staging": "nx run extension:build:staging",
    "build:staging:firefox": "nx run extension:build:staging:firefox",
    "zip": "cd packages/extension && wxt zip",
    "zip:firefox": "cd packages/extension && wxt zip -b firefox",
    "zip:staging": "cd packages/extension && wxt zip --mode staging && wxt zip --mode staging -b firefox",
    "zip:proding": "cd packages/extension && wxt zip --mode proding && wxt zip --mode proding -b firefox",
    "zip:production": "cd packages/extension && wxt zip --mode production && wxt zip --mode production -b firefox",
    "zip:all": "yarn zip:staging && yarn zip:proding && yarn zip:production",
    "submit": "node bin/submit.mjs",
    "release": "yarn semantic-release",
    "clean": "rm -rf .output packages/extension/.output packages/web/.next",
    "test": "nx run-many -t test && yarn test:release",
    "test:extension": "nx run extension:test",
    "test:release": "mocha 'bin/*.spec.mjs'",
    "test:web": "nx run web:test",
    "typecheck": "nx run-many -t typecheck",
    "lint": "yarn lint:ts",
    "lint:ts": "eslint './packages/**/*.{js,ts,tsx}'",
    "verify": "yarn test && yarn typecheck && yarn lint && yarn build:chromium",
    "verify:quick": "yarn test && yarn typecheck && yarn lint",
    "storybook": "start-storybook -s ./public --ci -p 6007 -c .storybook",
    "build-storybook": "build-storybook"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged ",
      "pre-push": "yarn verify:quick"
    }
  },
  "lint-staged": {
    "packages/**/*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint",
      "git add"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dis-moi/extension"
  },
  "homepage": "https://www.dismoi.io",
  "author": "DisMoi (https://github.com/dis-moi)",
