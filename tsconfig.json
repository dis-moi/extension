{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react",
    "baseUrl": "./src",
    "paths": {
      "test/*": ["../test/*"]
    },
    "types": [
      "chrome",
      "firefox-webext-browser",
      "mocha"
    ],
    "outDir": "./build",
    "sourceRoot": "./src"
  },
  "include": ["./src/**/*", "./test/app/**/*", "./.wxt/wxt.d.ts"],
  "exclude": [
    "node_modules",
    ".output",
    "./**/website/node_modules",
    "./**/website/.cache"
  ]
}
